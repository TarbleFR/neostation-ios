+- (void)loadSavestateIdentifier:(NSString*)identifier {
+  if (!identifier.length) return;
+  dispatch_async(_runtimeQueue, ^{
+    if (!self.activeTitleId.length) return;
+    rpcs3_ios_status status = self->_api.stop_emulation();
+    if (status == 0) status = self->_api.boot_game(self.activeTitleId.UTF8String, identifier.UTF8String);
+    if (status != 0) [self showMessage:@"Savestate" message:[self lastError]];
+    else RPCS3Diagnostic(@"savestate_load", identifier);
+  });
+}
+
+- (void)showLoadSavestateMenu {
+  NSString* titleId = self.activeTitleId;
+  if (!titleId.length) return;
+  dispatch_async(_runtimeQueue, ^{
+    NSMutableArray<NSDictionary*>* states = [NSMutableArray array];
+    rpcs3_ios_status status = self->_api.enumerate_savestates_live
+        ? self->_api.enumerate_savestates_live(titleId.UTF8String, RPCS3CollectSavestate, (__bridge void*)states)
+        : -1;
+    if (status != 0) {
+      [self showMessage:@"Savestates" message:[self lastError]];
+      return;
+    }
+    NSArray<NSDictionary*>* snapshot = [states copy];
+    dispatch_async(dispatch_get_main_queue(), ^{
+      RPCS3GameViewController* controller = self.gameController;
+      if (!controller || controller.presentedViewController) return;
+      if (!snapshot.count) {
+        [self showMessage:@"Savestates" message:@"Aucune savestate disponible pour ce jeu."];
+        return;
+      }
+      UIAlertController* alert = [UIAlertController alertControllerWithTitle:@"Charger une savestate"
+                                                                     message:nil
+                                                              preferredStyle:UIAlertControllerStyleAlert];
+      NSDateFormatter* formatter = [NSDateFormatter new];
+      formatter.dateStyle = NSDateFormatterShortStyle;
+      formatter.timeStyle = NSDateFormatterMediumStyle;
+      __weak Rpcs3InternalBridgePlugin* weakSelf = self;
+      NSUInteger index = 0;
+      for (NSDictionary* entry in snapshot) {
+        ++index;
+        NSString* identifier = entry[@"id"];
+        BOOL compatible = [entry[@"compatible"] boolValue];
+        int64_t modified = [entry[@"modified"] longLongValue];
+        NSDate* date = modified > 0 ? [NSDate dateWithTimeIntervalSince1970:(NSTimeInterval)modified] : nil;
+        NSString* dateText = date ? [formatter stringFromDate:date] : @"date inconnue";
+        NSString* label = [NSString stringWithFormat:@"%lu · %@%@", (unsigned long)index, dateText, compatible ? @"" : @" · incompatible"];
+        UIAlertAction* action = [UIAlertAction actionWithTitle:label style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction* selected) {
+          if (compatible) [weakSelf loadSavestateIdentifier:identifier];
+          else [weakSelf showMessage:@"Savestate" message:@"Cette savestate n’est pas compatible avec ce cœur RPCS3."];
+        }];
+        action.enabled = YES;
+        [alert addAction:action];
+      }
+      [alert addAction:[UIAlertAction actionWithTitle:@"Annuler" style:UIAlertActionStyleCancel handler:nil]];
+      [controller presentViewController:alert animated:YES completion:nil];
+    });
+  });
+}
