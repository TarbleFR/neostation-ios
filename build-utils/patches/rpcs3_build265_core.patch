diff --git a/rpcs3/Emu/RSX/VK/VKGSRender.cpp b/rpcs3/Emu/RSX/VK/VKGSRender.cpp
index 6a6e6c5..8fc4317 100644
--- a/rpcs3/Emu/RSX/VK/VKGSRender.cpp
+++ b/rpcs3/Emu/RSX/VK/VKGSRender.cpp
@@ -1022,12 +1022,39 @@ void VKGSRender::on_invalidate_memory_range(const utils::address_range32 &range,
 
 void VKGSRender::on_semaphore_acquire_wait()
 {
+#ifdef RPCS3_IOS
+	// NEOSTATION_BUILD265_RSX_SPU_VIDEO_V1
+	// Query resolution may itself submit commands and re-enter the wait hook.
+	if (m_servicing_semaphore_wait) return;
+	struct service_guard
+	{
+		bool& flag;
+		explicit service_guard(bool& value) : flag(value) { flag = true; }
+		~service_guard() { flag = false; }
+	} guard(m_servicing_semaphore_wait);
+#endif
 	if (m_flush_requests.pending() ||
+#ifdef RPCS3_IOS
+		(m_eng_interrupt_mask & rsx::pipe_flush_interrupt) ||
+#endif
 		(async_flip_requested & flip_request::emu_requested) ||
 		(m_queue_status & flush_queue_state::deadlock))
 	{
 		do_local_task(rsx::FIFO::state::lock_wait);
 	}
+#ifdef RPCS3_IOS
+	// The outer FIFO loop normally updates ZCULL and deferred host writes.
+	// An acquire blocks that loop: completed reports/labels must also progress
+	// here, or a PPU producer waiting for them can never release this acquire.
+	// Do not force a Vulkan submit per poll or re-enter an active submit.
+	if ((m_queue_status & flush_queue_state::flushing) ||
+		(++m_semaphore_wait_polls & 15) != 0) return;
+	const u64 now = get_system_time();
+	if (now < m_next_semaphore_service) return;
+	m_next_semaphore_service = now + 1'000;
+	if (zcull_ctrl) zcull_ctrl->update(this);
+	if (m_host_dma_ctrl) m_host_dma_ctrl->update();
+#endif
 }
 
 bool VKGSRender::on_vram_exhausted(rsx::problem_severity severity)
