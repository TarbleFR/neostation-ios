+    vkGetBufferMemoryRequirements(device, pending.buffer, &required);
+    const u64 alignment = std::max<u64>(host_alignment, required.alignment);
+    if (!alignment || alignment > 65536 || (alignment & (alignment - 1)) || required.size < info.size ||
+        required.size > 256 * MiB || required.size > std::numeric_limits<u64>::max() - (alignment - 1)) return false;
