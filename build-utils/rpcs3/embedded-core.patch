+        VkBuffer buffer = VK_NULL_HANDLE;
+        std::unique_ptr<neoswap_buffer_memory> memory;
+        ~candidate() { if (buffer) vkDestroyBuffer(device, buffer, nullptr); }
+    } pending{device, VK_NULL_HANDLE, nullptr};
+    VkExternalMemoryBufferCreateInfo external{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO};
+    external.handleTypes = query.handleType;
+    auto external_info = info;
+    external_info.pNext = &external;
