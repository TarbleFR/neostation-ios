+bool spu_runtime::initialize_static_trampolines(std::string& error) noexcept
+{
+	static std::mutex mutex;
+	static u32 state = 0; // 0 untouched, 1 failed/in progress, 2 ready
+	std::lock_guard lock(mutex);
+	if (state == 2)
+	{
+		return true;
