+    if (vkBindBufferMemory(device, pending.buffer, pending.memory->get_vk_device_memory(), 0) != VK_SUCCESS) return false;
+
+    output_memory = std::move(pending.memory);
+    output = std::exchange(pending.buffer, VK_NULL_HANDLE);
+    return true;
+}
