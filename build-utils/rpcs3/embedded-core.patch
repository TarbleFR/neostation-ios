+core_group classify_thread(std::string_view name)
+{
+	if (name.starts_with("PPUW.") || name.starts_with("PPU Exec") ||
+		name.starts_with("PPU Symbol") || name.starts_with("SPUW.") ||
+		name.starts_with("SPU Worker") || name.starts_with("SPU LLVM") ||
+		name.starts_with("RSX.W"))
+	{
+		return core_group::jit;
+	}
+	if (name.starts_with("PPU["))
+	{
+		return core_group::ppu;
+	}
+	if (name.starts_with("SPU") || name.starts_with("RawSPU"))
+	{
+		return core_group::spu;
+	}
+	if (name.starts_with("RSX"))
+	{
+		return core_group::rsx;
+	}
+	return core_group::other;
+}
