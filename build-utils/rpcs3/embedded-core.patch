diff --git a/rpcs3/Emu/Cell/SPUWarmupPolicy.h b/rpcs3/Emu/Cell/SPUWarmupPolicy.h
new file mode 100644
index 0000000..eb97f59
--- /dev/null
+++ b/rpcs3/Emu/Cell/SPUWarmupPolicy.h
@@ -0,0 +1,97 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <barrier>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace rpcs3::spu
+{
+// This phase belongs to the compiler's calling thread, not to presentation or
+// a global timer: a title may present a loading frame before warmup finishes.
+inline thread_local bool loading_warmup = false;
+inline thread_local bool replaying_metadata = false;
+
+struct warmup_scope
+{
+	bool previous = loading_warmup;
+	warmup_scope() noexcept { loading_warmup = true; }
+	~warmup_scope() { loading_warmup = previous; }
+};
+
+// Mark a known disk record only inside compile(), after its potentially
+// throwing program copy. Never pre-publish an unclaimed runtime item.
+struct metadata_replay_scope
+{
+	bool previous = replaying_metadata;
+	metadata_replay_scope() noexcept { replaying_metadata = true; }
+	~metadata_replay_scope() { replaying_metadata = previous; }
+};
+
+// A worker may throw during compiler initialization or analysis. Dropping its
+// participation during unwinding allows surviving workers to finish the phase.
+class warmup_barrier_guard
+{
+	std::barrier<>& barrier;
+	bool arrived = false;
+public:
+	explicit warmup_barrier_guard(std::barrier<>& value) noexcept : barrier(value) {}
+	~warmup_barrier_guard() { if (!arrived) barrier.arrive_and_drop(); }
+	void wait() { arrived = true; barrier.arrive_and_wait(); }
+};
+
+constexpr bool precompile_discovered(bool enabled, bool cache_enabled,
+	bool known_metadata_empty, bool targeted_warmup) noexcept
+{
+	return enabled && cache_enabled && (known_metadata_empty || targeted_warmup);
+}
+
+constexpr std::uint32_t warmup_worker_count(std::uint32_t existing_budget,
+	std::uint32_t configured_budget, bool ios) noexcept
+{
+	// Reuse the existing startup pool with a smaller budget. No background
+	// compiler is introduced and all workers join before guest execution.
+	const auto configured = configured_budget ? configured_budget : existing_budget;
+	return std::min(existing_budget, std::min(configured, ios ? 2u : existing_budget));
+}
+
+template <typename Word>
+void clear_warmup_local_store(std::span<Word> words) noexcept
+{
+	// A one-word program must clear one word as well. Leaving the final
+	// instruction behind changes analysis of the next cached program.
+	std::fill(words.begin(), words.end(), Word{});
+}
+
+struct compile_sample
+{
+	std::uint64_t count = 0, failures = 0, ticks = 0, maximum_ticks = 0;
+};
+
+class compile_counters
+{
+	std::atomic<std::uint64_t> count{0}, failures{0}, ticks{0}, maximum_ticks{0};
+public:
+	void record(std::uint64_t duration, bool succeeded) noexcept
+	{
+		count.fetch_add(1, std::memory_order_relaxed);
+		failures.fetch_add(!succeeded, std::memory_order_relaxed);
+		ticks.fetch_add(duration, std::memory_order_relaxed);
+		auto maximum = maximum_ticks.load(std::memory_order_relaxed);
+		while (maximum < duration && !maximum_ticks.compare_exchange_weak(
+			maximum, duration, std::memory_order_relaxed)) {}
+	}
+	// Each event is allocation-free and lock-free. A concurrently finishing
+	// event can straddle adjacent sample fields; sums over captured windows
+	// are meaningful, but a single window is not a transactional snapshot.
+	compile_sample take() noexcept
+	{
+		return {count.exchange(0, std::memory_order_relaxed),
+			failures.exchange(0, std::memory_order_relaxed),
+			ticks.exchange(0, std::memory_order_relaxed),
+			maximum_ticks.exchange(0, std::memory_order_relaxed)};
+	}
+};
+}
