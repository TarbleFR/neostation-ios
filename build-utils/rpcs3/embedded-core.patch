@@ -0,0 +1,15 @@
+#pragma once
+
+#include <cstdint>
+
+// Only split small, poorly bounded PPU regions into one JIT function per
+// instruction. Large regions can use the existing whole-block fallback.
+namespace ppu_analysis
+{
+	constexpr std::uint64_t max_unbounded_split_instructions = 65'536;
+
+	constexpr bool split_unbounded_blocks(bool used_fallback, std::uint64_t unbounded_bytes) noexcept
+	{
+		return !used_fallback && unbounded_bytes / 4 <= max_unbounded_split_instructions;
+	}
+}
