+thread_usage_sample sample_core_threads()
+{
+	thread_usage_sample result;
+#ifdef __APPLE__
+	thread_act_array_t threads = nullptr;
+	mach_msg_type_number_t thread_count = 0;
+	if (task_threads(mach_task_self(), &threads, &thread_count) != KERN_SUCCESS)
+	{
+		return result;
+	}
+
+	for (mach_msg_type_number_t index = 0; index < thread_count; ++index)
+	{
+		thread_extended_info_data_t info{};
+		mach_msg_type_number_t count = THREAD_EXTENDED_INFO_COUNT;
+		if (thread_info(threads[index], THREAD_EXTENDED_INFO,
+			reinterpret_cast<thread_info_t>(&info), &count) != KERN_SUCCESS)
+		{
+			mach_port_deallocate(mach_task_self(), threads[index]);
+			continue;
+		}
+
+		const usz group = static_cast<usz>(classify_thread(info.pth_name));
+		result.threads[group]++;
+		if (!(info.pth_flags & TH_FLAGS_IDLE))
+		{
+			result.cores[group] += static_cast<double>(info.pth_cpu_usage) / TH_USAGE_SCALE;
+		}
+		mach_port_deallocate(mach_task_self(), threads[index]);
+	}
+
+	vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(threads),
+		static_cast<vm_size_t>(thread_count) * sizeof(thread_t));
+#endif
+	return result;
+}
 
