+			g_cfg.video.relaxed_zcull_sync.from_string(state->relaxed ? "true" : "false");
+			continue;
+		}
+		const setting_record* setting = find_setting(key, setting_context::game);
+		if (!setting || !setting->entry->from_string(value))
+		{
+			return false;
+		}
+	}
+	return true;
