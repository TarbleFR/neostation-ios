+	std::vector<std::pair<std::string, std::string>> values;
+	if (!read_game_setting_overrides(title_id, values))
+	{
+		return false;
+	}
+	if (auto found = std::ranges::find_if(values, [&](const auto& item)
+	{
+		return item.first == key;
+	}); found != values.end())
+	{
+		found->second = value;
+	}
+	else
