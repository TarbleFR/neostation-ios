+	pipe_compiler* get_pipe_compiler()
+	{
+		ensure(g_pipe_compilers);
+		ensure(g_num_pipe_compilers > 0);
+
+		auto* const first = g_pipe_compilers.get()->begin();
+		const u32 start = static_cast<u32>(g_compiler_index++) % g_num_pipe_compilers;
+		pipe_compiler* best = first + start;
+		u32 best_load = best->pending_jobs();
+
+		// Rotate the scan origin for fair ties, but always assign behind the
+		// smallest queued + in-flight load. A long driver compile can no longer
+		// trap later jobs in the same round-robin shard while another worker idles.
+		for (u32 offset = 1; offset < static_cast<u32>(g_num_pipe_compilers) && best_load; ++offset)
+		{
+			pipe_compiler* const candidate = first + ((start + offset) % g_num_pipe_compilers);
+			const u32 load = candidate->pending_jobs();
+			if (load < best_load)
+			{
+				best = candidate;
+				best_load = load;
+			}
+		}
+
+		return best;
+	}
