# NeoStation iOS build-time environment variables.
#
# Local macOS build:
#   cp .env.example .env
#   # Fill the two required ScreenScraper values below, then use:
#   flutter build ios --release --no-codesign --dart-define-from-file=.env
#
# The real .env file is intentionally ignored by Git and must never be
# committed. These values are compiled into the app through Dart defines; the
# installed application does not read a runtime .env file.
#
# RetroAchievements has no build-time key here. Each user signs in with their
# own RetroAchievements credentials at runtime inside NeoStation.

# ScreenScraper developer credentials (required for the iOS CI build)
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# Optional. The Library can query Google Books without a key at public quota,
# but a production key can be compiled in to provide the configured API quota.
GOOGLE_BOOKS_API_KEY=
